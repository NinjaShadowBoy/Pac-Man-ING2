# Project: Projectp
# Portable-ish MinGW makefile derived from Dev-C++ output

MINGW_PREFIX ?= C:/Program Files (x86)/Dev-Cpp/MinGW64
SDL2_DIR ?= C:/SDL2/x86_64-w64-mingw32
PROJECT_DIR ?= .

CC ?= gcc.exe
WINDRES ?= windres.exe

BIN = Projectp.exe
RES = Projectp_private.res
OBJ = main.o button.o $(RES)

MINGW_LIB = -L"$(MINGW_PREFIX)/lib" -L"$(MINGW_PREFIX)/x86_64-w64-mingw32/lib"
SDL_LIB = -L"$(SDL2_DIR)/lib"
LIBS = $(MINGW_LIB) $(SDL_LIB) -mwindows -lmingw32 -lSDL2main -lSDL2 -lSDL2_ttf -lSDL2_image -lSDL2_mixer

INCS = -I"$(PROJECT_DIR)" -I"$(SDL2_DIR)/include" -I"$(MINGW_PREFIX)/include" -I"$(MINGW_PREFIX)/x86_64-w64-mingw32/include"
CFLAGS ?= $(INCS) -Wall -Wextra -g3

RM = del /q /f

.PHONY: all clean

all: $(BIN)

$(BIN): $(OBJ)
	$(CC) $(OBJ) -o "$(BIN)" $(LIBS)

main.o: main.c
	$(CC) -c main.c -o main.o $(CFLAGS)

button.o: button.c
	$(CC) -c button.c -o button.o $(CFLAGS)

$(RES): Projectp_private.rc
	$(WINDRES) -i Projectp_private.rc --input-format=rc -o $(RES) -O coff

clean:
	-$(RM) $(OBJ) $(BIN)
